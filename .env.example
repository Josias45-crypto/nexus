# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# .env nunca se sube al repositorio. Aquí solo hay valores de ejemplo (sin secretos).
# Cada valor de este archivo es el mismo que usa NEXUS si la variable no está definida.

# --- Chat: OpenRouter (único proveedor; docs/MODO_NUBE.md) ---
# Key solo en .env. Nunca la compartas ni la subas al repo.
OPENROUTER_API_KEYS=
# Modelos (sin valor en el código; lista: https://openrouter.ai/models)
# Uso diario:
NEXUS_OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Potente, solo cuando el jefe lo pide («analiza a fondo», «piénsalo bien», «dame tu opinión»):
NEXUS_OPENROUTER_MODEL_DEEP=anthropic/claude-sonnet-5.5
# Respaldo del potente: solo si está caído, limitado (429) o el modelo no existe; nunca por
# falta de saldo, clave rechazada o tope diario (ahí avisa y todo queda en cola).
NEXUS_OPENROUTER_MODEL_DEEP_RESPALDO=deepseek/deepseek-v4-pro
# Tope de gasto diario en USD (vacío = sin tope). Al alcanzarlo, avisa y espera a mañana.
# Ver el gasto en GET /usage. La búsqueda en internet (Exa por OpenRouter, ~0,008 USD cada una) no
# tiene variable: su tope diario (20) vive en [internet] de profiles/isabelle.toml.
NEXUS_DAILY_BUDGET_USD=

# --- Embeddings (Fase 4): por OpenRouter, solo zdr + data_collection=deny ---
# Modelo y dimensión van juntos: cambiarlos crea una tabla de vectores nueva; llénala con
# curl -X POST "localhost:8000/reindex?solo_vectores=true" (progreso: GET /reindex).
NEXUS_EMBED_MODEL=baai/bge-m3
NEXUS_EMBED_DIM=1024
# Carpeta de datos dentro del contenedor
NEXUS_DATA_DIR=/data
# Puerto del núcleo en el anfitrión, siempre en 127.0.0.1 (en el VPS compartido: 8100; docs/DESPLIEGUE.md)
NEXUS_PORT=8000
# Dónde escucha ese puerto: 127.0.0.1 (seguro, por túnel SSH). 0.0.0.0 publica la web por HTTP SIN
# cifrar (riesgos y cómo volver: docs/DESPLIEGUE.md, paso 7b)
NEXUS_BIND=127.0.0.1
# Cookie de sesión con Secure: auto (según la conexión o X-Forwarded-Proto), on u off
NEXUS_COOKIE_SECURE=auto
# Tamaño máximo por archivo o texto recibido, en MB
NEXUS_MAX_UPLOAD_MB=50
# Distancia máxima para usar un recuerdo (calibrada para bge-m3 con tests/eval_ventas.py)
NEXUS_MAX_DISTANCE=0.92
# Margen extra si el recuerdo también coincide por palabras
NEXUS_FTS_MARGIN=0.05
# Un nombre propio o cifra de la pregunta que aparece en <= N trozos entra siempre en /ask
NEXUS_RARE_MAX_DF=5
# /ask: candidatos que recibe el modelo (él decide cuáles usar) y filtro laxo contra ruido
NEXUS_ASK_CANDIDATES=4
# ...y para preguntas que piden una lista o juntar varias notas
NEXUS_ASK_CANDIDATES_LIST=8
NEXUS_NOISE_DISTANCE=1.05

# Perfil de rubro (profiles/*.toml): general, ventas...
NEXUS_PROFILE=general

# Nivel de registro: DEBUG, INFO, WARNING
NEXUS_LOG_LEVEL=INFO

# Procesamiento automático en segundo plano
NEXUS_WORKER=on
NEXUS_WORKER_INTERVAL=20
NEXUS_MAX_ATTEMPTS=3

# Digestión: resúmenes y conceptos de cada documento
NEXUS_DIGEST=on
NEXUS_DIGEST_MIN_CHARS=1200
# Documentos grandes: caracteres por sección y máximo de secciones a resumir
# (si hay más, se eligen repartidas de principio a fin; 0 = sin límite)
NEXUS_DIGEST_SECTION_CHARS=6000
NEXUS_DIGEST_MAX_SECTIONS=12

# Ver y oír (Fase 3): también por OpenRouter, solo proveedores zdr + data_collection=deny.
# Visión para fotos y PDF escaneados (elegido por precio y lectura de texto en español):
NEXUS_OPENROUTER_MODEL_VISION=qwen/qwen3.5-9b
# Transcripción de audios y notas de voz (endpoint /audio/transcriptions):
NEXUS_OPENROUTER_MODEL_AUDIO=openai/whisper-large-v3-turbo
# Tope de minutos por audio y páginas escaneadas sin preguntar: [medios] en profiles/isabelle.toml

# Comprimidos .zip: máximo de archivos y de MB descomprimidos que se leen
NEXUS_ARCHIVE_MAX_FILES=200
NEXUS_ARCHIVE_MAX_MB=200
# Texto máximo que se indexa por elemento (el original siempre se guarda entero)
NEXUS_MAX_TEXT_CHARS=2000000

# Recordatorios: revisar cada N s. El aviso previo (30 min), la insistencia (20 min x 3) y el estado
# «sin confirmar» son fijos (core/reminders.py). NEXUS_REMINDER_RETRY_MIN existe solo para pruebas.
NEXUS_SCHEDULER_INTERVAL=30
NEXUS_REMINDER_CONFIRM_MIN=15
# Canal por defecto para avisos proactivos
NEXUS_DEFAULT_CHANNEL=telegram

# Zona horaria (desfase UTC; Perú = -5) para contar los días de NEXUS
NEXUS_TZ_OFFSET=-5
# Respaldos: cada cuántas horas (0 = desactivar) y cuántas copias guardar
NEXUS_BACKUP_HOURS=24
NEXUS_BACKUP_KEEP=7
# Carpeta del anfitrión para los respaldos (apúntala a un disco externo)
# NEXUS_BACKUP_HOST_DIR=./backups

# --- Canales (docs/CANALES.md) ---
# Telegram: se activa con  docker compose --profile channels up -d
# Token de @BotFather (solo en .env; nunca lo compartas)
TELEGRAM_BOT_TOKEN=
# Ids numéricos de Telegram autorizados, separados por comas (los demás son ignorados)
TELEGRAM_ALLOWED_IDS=
# Cada cuántos segundos el canal revisa avisos pendientes (recordatorios, resumen)
NEXUS_CHANNEL_OUTBOX_SECONDS=5

# WhatsApp por la API oficial de Meta: APAGADO por defecto (docs/CANALES.md)
# Se activa con NEXUS_WHATSAPP=on y  docker compose --profile whatsapp up -d
NEXUS_WHATSAPP=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de la app de Meta: valida la firma de cada webhook
WHATSAPP_APP_SECRET=
# Texto que eliges tú y repites en la consola de Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# Números autorizados en formato internacional sin "+", separados por comas (ej. 51999000111)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Internas: rutas y direcciones que fija docker-compose.yml (normalmente no se tocan) ---
# Respaldos dentro del contenedor (en el anfitrión: NEXUS_BACKUP_HOST_DIR)
# NEXUS_BACKUP_DIR=/backups
# Perfiles de rubro dentro del contenedor (montados desde ./profiles)
# NEXUS_PROFILES_DIR=/app/profiles
# Dirección de la API de NEXUS que usan los canales (Telegram, WhatsApp)
# NEXUS_API_URL=http://core:8000
# Token interno de los canales: lo crea el núcleo en data/interno/token (no hace falta ponerlo aquí).
# La contraseña de la web NO va aquí: docker compose exec core python -m core.auth
