# Copia este archivo a .env y ajusta los valores.
# .env nunca se sube al repositorio.

# Proveedor de modelo local (la nube de pruebas se activa con NEXUS_ALLOW_CLOUD)
NEXUS_LLM_PROVIDER=ollama
# Dirección de Ollama (nombre del servicio dentro de Docker)
OLLAMA_BASE_URL=http://ollama:11434
# Modelo de lenguaje (debe estar descargado en Ollama)
NEXUS_LLM_MODEL=qwen2.5:1.5b
# Ollama remoto preferido para el chat (p. ej. PC con GPU por Tailscale: http://100.x.y.z:11434).
# Vacío = usar solo el local. Si el remoto no responde, NEXUS usa el local automáticamente.
# Los embeddings siempre usan OLLAMA_BASE_URL (el local), nunca el remoto.
NEXUS_LLM_URL=
# Modelo a usar en el remoto (vacío = el mismo que NEXUS_LLM_MODEL)
NEXUS_LLM_REMOTE_MODEL=

# --- Modo nube de pruebas -- APAGADO por defecto (docs/MODO_NUBE.md) ---
# Úsalo SOLO con datos de prueba: preguntas y digestión NO privadas pueden ir a la nube.
# Embeddings, audio, recordatorios, resumen y todo lo privado nunca salen de la máquina.
# Si la nube falla (límite, caída, red), responde el Ollama local.
NEXUS_ALLOW_CLOUD=off
NEXUS_CLOUD_ORDER=groq,gemini
# Una key por proveedor (lista separada por comas). Solo en .env; nunca en el repo.
GROQ_API_KEYS=
NEXUS_GROQ_MODEL=
GEMINI_API_KEYS=
NEXUS_GEMINI_MODEL=
OPENROUTER_API_KEYS=
NEXUS_OPENROUTER_MODEL=
# Segundos de espera por respuesta y enfriamiento mínimo de una key tras 429/5xx/timeout
NEXUS_CLOUD_TIMEOUT=30
NEXUS_CLOUD_COOLDOWN=60

# Modelo de embeddings (se usará desde el Paso 5)
NEXUS_EMBED_MODEL=nomic-embed-text
# Carpeta de datos dentro del contenedor
NEXUS_DATA_DIR=/data
# Tamaño máximo por archivo o texto recibido, en MB
NEXUS_MAX_UPLOAD_MB=50
# Distancia máxima para usar un recuerdo (recalibrar con: python3 tests/calibrate.py)
NEXUS_MAX_DISTANCE=0.78
# Margen extra si el recuerdo también coincide por palabras
NEXUS_FTS_MARGIN=0.04

# Perfil de rubro (profiles/*.toml): general, ventas...
NEXUS_PROFILE=general

# Nivel de registro: DEBUG, INFO, WARNING
NEXUS_LOG_LEVEL=INFO

# Procesamiento automático en segundo plano
NEXUS_WORKER=on
NEXUS_WORKER_INTERVAL=20
NEXUS_MAX_ATTEMPTS=3

# Digestión: resúmenes y conceptos de cada documento
NEXUS_DIGEST=on
NEXUS_DIGEST_MIN_CHARS=1200
# Documentos grandes: caracteres por sección y máximo de secciones a resumir
# (si hay más, se eligen repartidas de principio a fin; 0 = sin límite)
NEXUS_DIGEST_SECTION_CHARS=6000
NEXUS_DIGEST_MAX_SECTIONS=12

# Oído: transcripción de audio (faster-whisper, en CPU)
NEXUS_WHISPER_MODEL=small
NEXUS_WHISPER_LANG=es
NEXUS_WHISPER_THREADS=4

# Vista: OCR local (Tesseract) para imágenes y PDF escaneados (docs/FORMATOS.md)
NEXUS_OCR=on
NEXUS_OCR_LANGS=spa+eng
NEXUS_OCR_MAX_PAGES=50
NEXUS_OCR_TIMEOUT=120
# Describir fotos con un modelo de visión de Ollama LOCAL (vacío = apagado).
# Antes: docker exec nexus-ollama ollama pull <modelo de visión>
NEXUS_VISION_MODEL=

# Comprimidos .zip: máximo de archivos y de MB descomprimidos que se leen
NEXUS_ARCHIVE_MAX_FILES=200
NEXUS_ARCHIVE_MAX_MB=200
# Texto máximo que se indexa por elemento (el original siempre se guarda entero)
NEXUS_MAX_TEXT_CHARS=2000000

# Recordatorios: revisar cada N s; insistir cada N minutos hasta M avisos sin /hecho
NEXUS_SCHEDULER_INTERVAL=30
NEXUS_REMINDER_RETRY_MIN=30
NEXUS_REMINDER_MAX_TRIES=3
# Canal por defecto para avisos proactivos
NEXUS_DEFAULT_CHANNEL=telegram

# Zona horaria (desfase UTC; Perú = -5) para contar los días de NEXUS
NEXUS_TZ_OFFSET=-5
# Respaldos: cada cuántas horas (0 = desactivar) y cuántas copias guardar
NEXUS_BACKUP_HOURS=24
NEXUS_BACKUP_KEEP=7
# Carpeta del anfitrión para los respaldos (apúntala a un disco externo)
# NEXUS_BACKUP_HOST_DIR=./backups

# --- Canales (docs/CANALES.md) ---
# Telegram: se activa con  docker compose --profile channels up -d
# Token de @BotFather (solo en .env; nunca lo compartas)
TELEGRAM_BOT_TOKEN=
# Ids numéricos de Telegram autorizados, separados por comas (los demás son ignorados)
TELEGRAM_ALLOWED_IDS=
# Cada cuántos segundos el canal revisa avisos pendientes (recordatorios, resumen)
NEXUS_CHANNEL_OUTBOX_SECONDS=15

# WhatsApp por la API oficial de Meta: APAGADO por defecto (docs/CANALES.md)
# Se activa con NEXUS_WHATSAPP=on y  docker compose --profile whatsapp up -d
NEXUS_WHATSAPP=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret de la app de Meta: valida la firma de cada webhook
WHATSAPP_APP_SECRET=
# Texto que eliges tú y repites en la consola de Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# Números autorizados en formato internacional sin "+", separados por comas (ej. 51999000111)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_GRAPH_VERSION=v21.0
