# Copia este archivo a .env y ajusta los valores.
# .env nunca se sube al repositorio.

# Proveedor de modelo: por ahora solo "ollama"
NEXUS_LLM_PROVIDER=ollama
# Dirección de Ollama (nombre del servicio dentro de Docker)
OLLAMA_BASE_URL=http://ollama:11434
# Modelo de lenguaje (debe estar descargado en Ollama)
NEXUS_LLM_MODEL=qwen2.5:1.5b
# Modelo de embeddings (se usará desde el Paso 5)
NEXUS_EMBED_MODEL=nomic-embed-text
# Carpeta de datos dentro del contenedor
NEXUS_DATA_DIR=/data
